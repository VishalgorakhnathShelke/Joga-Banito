# =========================
# AI Tax Guidance and Compliance Review Agent
# Gemini + Groq Version
# =========================

# -------------------------
# Agent 1: Gemini
# CA Tax Guidance Agent
# -------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# -------------------------
# Agent 2: Groq
# Senior CA Compliance Review Agent
# -------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# -------------------------
# Optional Web Search
# Later we will use this for ATO and TPB rule checking
# -------------------------
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_MAX_RESULTS=5

# -------------------------
# Tax Project Settings
# -------------------------
COUNTRY=Australia
TAX_AUTHORITY=Australian Taxation Office
REGULATOR=Tax Practitioners Board
DEFAULT_TAX_YEAR=2025-2026

# -------------------------
# Official Website Sources
# -------------------------
ATO_BASE_URL=https://www.ato.gov.au
TPB_BASE_URL=https://www.tpb.gov.au

# -------------------------
# File Handling Settings
# Later used for receipts, invoices, PDFs, Excel files
# -------------------------
MAX_FILE_CHARS=12000
UPLOADS_DIR=uploads
OUTPUTS_DIR=outputs

# -------------------------
# App Settings
# -------------------------
APP_ENV=development
DEBUG=True